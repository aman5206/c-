{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "C++ Build and Run",
      "type": "shell",
      "command": "g++",
      "args": [
        "-o",
        "${fileDirname}\\${fileBasenameNoExtension}.exe",
        "${file}",
        "-std=c++17",
        "&&",
        "${fileDirname}\\${fileBasenameNoExtension}.exe"
      ],
      "options": {
        "shell": {
          "executable": "cmd.exe",
          "args": ["/d", "/c"]
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    }
  ]
}